{
  "name": "multicoyn-sdk",
  "version": "0.1.0",
  "description": "React SDK for integrating blockchain payment modals into your application",
  "type": "module",
  "main": "./dist/multicoyn-sdk.cjs.js",
  "module": "./dist/multicoyn-sdk.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/multicoyn-sdk.es.js",
      "require": "./dist/multicoyn-sdk.cjs.js"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.lib.json && vite build",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "playground": "cd playground && npm install && npm run dev"
  },
  "keywords": [
    "react",
    "sdk",
    "payment",
    "blockchain",
    "crypto",
    "modal",
    "web3",
    "wallet"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
